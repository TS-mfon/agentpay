{
  "name": "agentpay",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:contracts": "node tools/contracts.mjs test",
    "build:contracts": "node tools/contracts.mjs build",
    "test:e2e": "playwright test",
    "worker": "tsx tools/worker.ts",
    "check:secrets": "node tools/check-project.mjs",
    "check:genlayer": "node tools/check-genlayer.mjs",
    "deploy:contracts": "tsx tools/deploy-aevum.ts",
    "deploy:genlayer": "tsx tools/deploy-genlayer.ts",
    "verify:network": "tsx tools/verify-aevum.ts",
    "wallets:create": "tsx tools/create-wallets.ts",
    "package:demo": "node tools/package-demo.mjs",
    "record:demo": "node tools/record-demo.mjs",
    "mcp": "tsx mcp/server.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.4.0",
    "@next/env": "16.4.6",
    "@zerodev/ecdsa-validator": "5.4.9",
    "@zerodev/sdk": "5.5.12",
    "genlayer-js": "2.0.0",
    "lucide-react": "^0.577.0",
    "mongodb": "^7.0.0",
    "next": "16.4.6",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "server-only": "^0.0.1",
    "viem": "^2.40.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@foundry-rs/forge": "1.7.1",
    "@openzeppelin/contracts": "^5.4.0",
    "@playwright/test": "^1.58.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitest/coverage-v8": "^4.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vitest": "^4.0.0"
  }
