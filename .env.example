# The dapp defaults to live mode. Configure Atlas and deployed contracts privately.
AGENTPAY_MODE=live
APP_ORIGIN=http://localhost:3000
# Atlas free-tier: use separate database names for demo and live.
MONGODB_URI=
AGENTPAY_DATABASE=agentpay
# These public settings are needed for live setup.
AEVUM_RPC_URL=https://rpc-test.qday.info
AEVUM_EXECUTOR_ADDRESS=
GENLAYER_NETWORK=studio-dev
GENLAYER_RPC_URL=
GENLAYER_CONTRACT_ADDRESS=
# Secret keys belong only on the worker, except deployer for explicit deployment.
AEVUM_EXECUTOR_PRIVATE_KEY=
GENLAYER_OPERATOR_PRIVATE_KEY=
AEVUM_DEPLOYER_PRIVATE_KEY=
AEVUM_OWNER_ADDRESS=
# Optional authenticated workflow dispatch, server-only.
GITHUB_REPOSITORY=
GITHUB_DISPATCH_TOKEN=
# Optional curated live service list. No vendors are assumed verified.
AGENTPAY_SERVICES_JSON=[]
